# Day 03 Lab v2 — Research Agent
# Copy this file to `.env` (same folder) and fill in your keys.
# NEVER commit `.env` — it is gitignored. Keys here are NAMES ONLY (no values).

# --- Model provider (choose ONE; OpenRouter recommended) ---
OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# OpenAI-compatible gateway (optional). Use only credentials issued by that gateway.
# OPENAI_BASE_URL=https://api.xah.io/v1
LAB_PROVIDER=openai
LAB_MODEL=gemini-2.5-flash-lite
PROVIDER_TIMEOUT_SECONDS=45
PROVIDER_MAX_RETRIES=1
# Optional alternative .env path: DAY03_ENV_FILE (legacy DAY04_ENV_FILE also works).

# --- Local small model (bonus challenge, no key needed) ---
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=qwen2.5:7b

# --- Research / read tools ---
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
# Public Tavily Search/Extract, rate-limited; opt in when no Tavily/Firecrawl key.
TAVILY_ACCESS_MODE=keyless
FETCH_PROVIDER=auto
RAPIDAPI_KEY=
RAPIDAPI_TWITTER_HOST=twitter-api45.p.rapidapi.com
ARXIV_USER_AGENT=AI20k-Day03-Research-Agent/1.0 (educational lab)

# --- Bonus delivery (optional, advanced track) ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
